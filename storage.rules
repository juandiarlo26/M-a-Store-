rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isVerifiedAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true && (
          (
            'email' in request.auth.token &&
            request.auth.token.email is string &&
            request.auth.token.email.lower() in ['juandiegooardilalopez@gmail.com', 'miastore0527@gmail.com']
          ) ||
          firestore.exists(/databases/ai-studio-2a39ff5a-81ea-4e28-8767-6b81e8ab31bf/documents/admins/$(request.auth.uid)) ||
          (
            'email' in request.auth.token &&
            request.auth.token.email is string &&
            firestore.exists(/databases/ai-studio-2a39ff5a-81ea-4e28-8767-6b81e8ab31bf/documents/staff/$(request.auth.token.email.lower()))
          )
        );
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() &&
        request.resource != null &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isVerifiedAdmin();
    }
  }
}
